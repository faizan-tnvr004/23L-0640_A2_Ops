# Copy to .env (git-ignored) and fill in. NEVER commit .env.
# Keep comments on their own lines (some .env parsers mishandle trailing comments).

# ---- app / docker compose ----
PROJECT_NAME=ROLLNO_A2_Ops
STUDENT_ROLL_NUMBER=ROLLNO
SECRET_KEY=replace-with-a-long-random-string
# Threshold you calibrated on VALIDATION data in Task 2.5
DECISION_THRESHOLD=0.5
MAX_CONTENT_LENGTH_MB=5
MODEL_VERSION=v2-champion-mobilenetv2
MODEL_PATH=models/champion_model.keras
# Local default; docker-compose overrides this with the Postgres URL
DATABASE_URL=sqlite:///visionguard.db
WEB_PORT=5000
POSTGRES_USER=visionguard
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=visionguard

# ---- cloud API protection / gateway mode (Task 7 / 8) ----
# On the SERVER: set API_KEY to require an X-API-Key header on /predict
API_KEY=
# On the LOCAL Flask app: set CLOUD_API_URL (e.g. http://<EC2-IP>:8000) to enter gateway mode
CLOUD_API_URL=
# Key the local app sends (same value as the server's API_KEY)
CLOUD_API_KEY=

# ---- DagsHub / MLflow (Task 3) ----
MLFLOW_TRACKING_URI=https://dagshub.com/<user>/<repo>.mlflow
MLFLOW_TRACKING_USERNAME=<dagshub-username>
MLFLOW_TRACKING_PASSWORD=<dagshub-access-token>
